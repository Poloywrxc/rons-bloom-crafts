# ==============================================================================
# Ron's Bloom Crafts - Environment Variables Template
# ==============================================================================

# Application URL (Production Domain)
NEXT_PUBLIC_APP_URL=https://rons-bloom-crafts.vercel.app

# Supabase Configuration (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend Administrative Key (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Outgoing Email Notifications (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-16-char-app-password
SMTP_FROM="Ron's Bloom Crafts <your-email@gmail.com>"
